function gcd(a, b) {
  let x = Math.abs(a);
  let y = Math.abs(b);
  while (y !== 0) {
    const temp = y;
    y = x % y;
    x = temp;
  }
  return x || 1;
}

function simplifyFraction(numerator, denominator) {
  const safeDenominator = denominator || 1;
  const divisor = gcd(numerator, safeDenominator);
  return {
    numerator: numerator / divisor,
    denominator: safeDenominator / divisor,
    label: `${numerator}/${safeDenominator}`,
    simplifiedLabel: `${numerator / divisor}/${safeDenominator / divisor}`,
    isEquivalent: divisor > 1,
  };
}

function parseFractionLabel(label) {
  const [numerator, denominator] = String(label)
    .split("/")
    .map((value) => Number(value.trim()));

  return simplifyFraction(numerator, denominator);
}

function fractionToPercentage(numerator, denominator) {
  const safeDenominator = denominator || 1;
  const percentage = (numerator / safeDenominator) * 100;
  const rounded = Number(percentage.toFixed(1));
  return Number.isInteger(rounded) ? `${rounded}%` : `${rounded}%`;
}

const baseFractions = Array.from({ length: 10 }, (_, i) => {
  const denominator = i + 1;
  return {
    denominator,
    label: `1/${denominator}`,
  };
});

const allFractions = Array.from({ length: 10 }, (_, denominatorIndex) => {
  const denominator = denominatorIndex + 1;
  return Array.from({ length: denominator }, (_, numeratorIndex) => {
    const numerator = numeratorIndex + 1;
    const simplified = simplifyFraction(numerator, denominator);
    return {
      numerator,
      denominator,
      label: `${numerator}/${denominator}`,
      simplifiedLabel: simplified.simplifiedLabel,
      isEquivalent: simplified.isEquivalent,
    };
  });
}).flat();

function explanationForFraction(fraction) {
  if (fraction.numerator === fraction.denominator) {
    return `${fraction.label} is één hele.`;
  }

  if (fraction.isEquivalent) {
    return `${fraction.label} betekent ${fraction.numerator} van de ${fraction.denominator} stukjes. Deze breuk is hetzelfde als ${fraction.simplifiedLabel}.`;
  }

  return `${fraction.label} betekent ${fraction.numerator} van de ${fraction.denominator} gelijke stukjes.`;
}

function shuffle(array) {
  return [...array].sort(() => Math.random() - 0.5);
}

function randomFraction() {
  return allFractions[Math.floor(Math.random() * allFractions.length)];
}

function randomQuestion() {
  const fraction = randomFraction();
  const correct = fraction.label;
  const equivalent = fraction.simplifiedLabel;

  const distractors = shuffle(
    allFractions
      .filter((item) => item.label !== correct && item.simplifiedLabel !== equivalent)
      .map((item) => item.label)
  ).slice(0, 3);

  return {
    ...fraction,
    correct,
    equivalent,
    choices: shuffle([correct, ...distractors]),
  };
}

function FractionBar({ denominator, numerator = 1 }) {
  return (
    <div className="w-full flex gap-1">
      {Array.from({ length: denominator }, (_, i) => (
        <div
          key={i}
          className={`h-10 flex-1 rounded-lg border border-slate-300 ${
            i < numerator ? "bg-sky-500" : "bg-slate-100"
          }`}
        />
      ))}
    </div>
  );
}

function FractionCircles({ denominator, numerator = 1 }) {
  const columns = Math.min(denominator, 5);

  return (
    <div
      className="gap-2 w-full max-w-md"
      style={{ display: "grid", gridTemplateColumns: `repeat(${columns}, minmax(0, 1fr))` }}
    >
      {Array.from({ length: denominator }, (_, i) => (
        <div
          key={i}
          className={`aspect-square rounded-full border-2 border-slate-300 ${
            i < numerator ? "bg-emerald-400" : "bg-white"
          }`}
        />
      ))}
    </div>
  );
}

function PizzaVisual({ denominator, numerator = 1 }) {
  const angle = 360 / denominator;
  const segments = Array.from({ length: denominator }, (_, i) => {
    const start = i * angle;
    const end = start + angle;
    const filled = i < numerator;
    return { start, end, filled };
  });

  const polarToCartesian = (cx, cy, r, angleInDegrees) => {
    const angleInRadians = ((angleInDegrees - 90) * Math.PI) / 180;
    return {
      x: cx + r * Math.cos(angleInRadians),
      y: cy + r * Math.sin(angleInRadians),
    };
  };

  const describeArc = (x, y, radius, startAngle, endAngle) => {
    const start = polarToCartesian(x, y, radius, endAngle);
    const end = polarToCartesian(x, y, radius, startAngle);
    const largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";
    return ["M", x, y, "L", start.x, start.y, "A", radius, radius, 0, largeArcFlag, 0, end.x, end.y, "Z"].join(" ");
  };

  return (
    <svg viewBox="0 0 200 200" className="w-56 h-56">
      <circle cx="100" cy="100" r="86" fill="#f8fafc" stroke="#cbd5e1" strokeWidth="2" />
      {segments.map((segment, index) => (
        <path
          key={index}
          d={describeArc(100, 100, 86, segment.start, segment.end)}
          fill={segment.filled ? "#f59e0b" : "#e2e8f0"}
          stroke="#ffffff"
          strokeWidth="2"
        />
      ))}
      <circle cx="100" cy="100" r="4" fill="#475569" />
    </svg>
  );
}

function runInlineTests() {
  const tests = [
    {
      name: "5/10 vereenvoudigt naar 1/2",
      pass: simplifyFraction(5, 10).simplifiedLabel === "1/2",
    },
    {
      name: "4/4 blijft een hele",
      pass: simplifyFraction(4, 4).simplifiedLabel === "1/1",
    },
    {
      name: "3/7 blijft 3/7",
      pass: simplifyFraction(3, 7).simplifiedLabel === "3/7",
    },
    {
      name: "parse van 6/8 wordt 3/4",
      pass: parseFractionLabel("6/8").simplifiedLabel === "3/4",
    },
    {
      name: "5/10 is 50%",
      pass: fractionToPercentage(5, 10) === "50%",
    },
    {
      name: "1/4 is 25%",
      pass: fractionToPercentage(1, 4) === "25%",
    },
    {
      name: "1/8 is 12.5%",
      pass: fractionToPercentage(1, 8) === "12.5%",
    },
  ];

  tests.forEach((test) => {
    if (!test.pass) {
      console.error(`Test mislukt: ${test.name}`);
    }
  });
}

runInlineTests();

